<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - inmobiliaria_front</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/inmobiliaria_front.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">INMOBILIARIAUNI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @*Condicional que nos dice que si el usuario esta con el rol seleccionado*@
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Ventanas/Inicio/">Inicio</a>
                            </li>
                            <li class="nav-item dropdown" style="color: black">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="navRecepcionControl" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Creacion de superiores
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="navRecepcionControl" style="border-radius: 12px;">
                                    <li><a class="dropdown-item" asp-page="/Ventanas/CrearAdministrador">Crear Administrador</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/CrearJefe">Crear Jefes</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown" style="color: black">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="navRecepcionControl" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Manejo de ubicaciones
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="navRecepcionControl" style="border-radius: 12px;">
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Nacionalidades">Nacionalidades</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Departamentos">Departamentos</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Sectores">Sectores</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Ventanas/TiposPropiedades">Tipos Propiedades</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Ventanas/Auditorias">Auditorias</a>
                            </li>
                        }

                        @if (User.IsInRole("Jefe"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Ventanas/Inicio">Inicio</a>
                            </li>
                            <li class="nav-item dropdown" style="color: black">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="navRecepcionControl" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Seccion empleados
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="navRecepcionControl" style="border-radius: 12px;">
                                    <li><a class="dropdown-item" asp-page="/Ventanas/CrearEmpleados">Crear Empleado</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/VerEmpleados">Empleados</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown" style="color: black">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="navRecepcionControl" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Tipos de contratos
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="navRecepcionControl" style="border-radius: 12px;">
                                    <li><a class="dropdown-item" asp-page="/Ventanas/ContratosArriendos">Contratos de Arriendos</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/ContratosContados">Contrato de Contados</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/ContratosCuotas">Contratos de Cuotas</a></li>
                                </ul>
                            </li>                       
                        }

                        @if (User.IsInRole("Empleado"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Ventanas/Inicio">Inicio</a>
                            </li>
                            <li class="nav-item dropdown" style="color: black">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="navRecepcionControl" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Tipos de contratos
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="navRecepcionControl" style="border-radius: 12px;">
                                    <li><a class="dropdown-item" asp-page="/Ventanas/ContratosArriendos">Contratos de Arriendos</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/ContratosContados">Contrato de Contados</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/ContratosCuotas">Contratos de Cuotas</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown" style="color: black">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="navRecepcionControl" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Registrar de usuarios
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="navRecepcionControl" style="border-radius: 12px;">
                                    <li><a class="dropdown-item" asp-page="/Ventanas/CrearCliente">Crear Cliente</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/CrearCodeudor">Crear Codeudor</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/CrearComprador">Crear Comprador</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/ActivoFinanciero">Activo Financiero</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Bienes">Bienes</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Direcciones">Direcciones</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Telefonos">Telefonos</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown" style="color: black">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="navRecepcionControl" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Vistas de usuarios
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="navRecepcionControl" style="border-radius: 12px;">
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Clientes">Clientes</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Codeudores">Codeudores</a></li>
                                    <li><a class="dropdown-item" asp-page="/Ventanas/Compradores">Compradores</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Ventanas/Propiedades">Propiedades</a>
                            </li>
                        }

                        @if (User.Identity!.IsAuthenticated)
                        {
                            <form method="POST">
                                @Html.AntiForgeryToken()
                                <input type="submit"
                                       value="Cerrar Sesion"
                                       class="btn btn-secondary"
                                       asp-page="/Index"
                                       asp-page-handler="BtCerrarSesion" />
                            </form>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - inmobiliaria_front - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
