@page
@using presentacion_aspnetcore.Pages
@model AuditoriasModel
@{
    ViewData["Title"] = "Auditorias";
}
<center>
    <div>
        <form method="POST"  @*Indica como se enviaran los datos*@
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()     @*Esto es un token para darle privacidad a la pagina*@

            <div align="left">
                <h3>Auditorias</h3>
            </div>

            <div>
                @if (Model.enviarReporte == false)
                {
                    <input type="submit"
                           style="margin-bottom: 15px"
                           value="Refrescar"
                           class="btn btn-secondary"
                           asp-page-handler="BtRefrescar"/>
                    <input type="submit"
                           style="margin-bottom: 15px"
                           value="Reporte"
                           class="btn btn-secondary"
                           asp-page-handler="BtReporte"
                           disabled="@(Model.Lista!.Count() == 0)" />
                }
            </div>

             @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
            }

            @if (Model.enviarReporte)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Deseas generar un informe sobre los movimientos actuales <br/>
                                de la empresa?
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   style="margin-bottom: 15px"
                                   value="Exportar Excel"
                                   class="btn btn-success"
                                   asp-page-handler="BtExcel" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.enviarReporte == false)
            {
                <table class="tb_data table table-striped table-bordered table-hover"> 
                    <tr>
                        <td>
                            Tipo
                        </td>
                        <td>
                            Entidad Modificada
                        </td>
                        <td>
                            IdEntidad
                        </td>
                        <td>
                            Fecha
                        </td>
                        <td>
                            Descripcion
                        </td>
                    </tr>
                    @foreach (var lista in Model.Lista)
                    {
                        <tr>
                            <td>
                                @lista.TipoAccion
                            </td>
                            <td>
                                @lista.Entidad
                            </td>
                            <td>
                                @lista.IdEntidad
                            </td>
                            <td>
                                @lista.Fecha
                            </td>
                            <td>
                                @lista.Descripcion
                            </td>
                        </tr>                     
                    }
                </table>
            }
        </form>
    </div>
</center>