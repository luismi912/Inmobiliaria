@page
@using presentacion_aspnetcore.Pages
@model SectoresModel
@{
    ViewData["Title"] = "Sectores";
}
<center>
    <div>
        <form method="POST"  @*Indica como se enviaran los datos*@
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()     @*Esto es un token para darle privacidad a la pagina*@

            <div align="left">
                <h3>Sectores</h3>
            </div>

            <div>
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Refrescar"
                    class="btn btn-secondary"         @*Crear botones para la utilizacion de paginas""*@
                    asp-page-handler="BtRefrescar" />
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Nuevo"
                    class="btn btn-secondary"
                    asp-page-handler="BtNuevo"
                    disabled="@(Model.Sector != null)"/>     @*Hace que el boton quede deshabilitado segun la condicion*@
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Guardar"
                    class="btn btn-secondary"
                    asp-page-handler="BtGuardar"
                    disabled="@(Model.Sector == null)"/>
            </div>

            @if (Model.Sector != null)
            {
                <input type="hidden" 
                    asp-for="@Model.Sector!.Id"/>     @*Sirve para guardar datos sin que el usuario lo vea*@

                <div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Sector!.Nombre" />
                        </div>
                    </div>                
                    <div class="form-group">
                        <label>
                            Estado
                        </label>
                        <div class="col-6">
                            <input id="inEstado"
                                   asp-for="@Model.Sector!.Estado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Departamento
                        </label>
                        <div class="col-6">
                            @if (Model.ListaCiudad != null)
                            {
                                <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                        asp-for="@Model.Sector!.Ciudad" @*Lo guarda en TipoPropiedad*@
                                        asp-items="@(new SelectList(Model.ListaCiudad, "Id", "Nombre"))">
                                    @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                                    <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                                </select>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Latitud</label>
                        <div class="col-6">
                            <input class="cts_forms form-control"
                                   asp-for="@Model.Sector!.Latitud" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Longitud</label>
                        <div class="col-6">
                            <input class="cts_forms form-control"
                                   asp-for="@Model.Sector!.Longitud" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
            }

            @if (Model.Sector != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Sectors?
                            </h6>
                            <h6 align="left">
                                @Model.Sector!.Nombre
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>                       
                        <th class="cl_hidden">
                            Estado
                        </th>
                        <th class="cl_hidden">
                            Ciudad
                        </th>
                        <th class="cl_hidden">
                            Latitud
                        </th>
                        <th class="cl_hidden">
                            Longitud
                        </th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <th>
                                @elemento.Nombre
                            </th>                           
                            <th class="cl_hidden">
                                @elemento.Estado
                            </th>
                            <th class="cl_hidden">
                                @(Model.ListaCiudad!.FirstOrDefault(c => c.Id == elemento.Ciudad)?.Nombre ?? "Sin tipo")
                            </th>
                            <th>
                                @elemento.Latitud
                            </th>                           
                            <th class="cl_hidden">
                                @elemento.Longitud
                            </th>
                            <th>
                                <input type="submit"
                                    value="Modificar"
                                    asp-page-handler="BtModificar"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                                <input type="submit"
                                    value="Borrar"
                                    asp-page-handler="BtBorrarVal"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                            </th>
                        </tr>
                    }  
                </table>

                @if (Model.Lista != null && Model.Lista.Count > 0)
                {
                    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
                    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

                    <div id="map" style="height: 500px; margin-top: 20px; border-radius: 8px; border: 1px solid #ccc;"></div>

                    <script>
                        const sectores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lista));

                        const map = L.map('map').setView([4.5709, -74.2973], 5);

                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap'
                        }).addTo(map);

                        sectores.forEach(s => {
                        if (s.Latitud == null || s.Longitud == null) return;

                        L.circleMarker([s.Latitud, s.Longitud], {
                        radius: 12,
                        fillColor: s.Estado ? '#1D9E75' : '#888780',
                        color: s.Estado ? '#0F6E56' : '#5F5E5A',
                        weight: 2,
                        fillOpacity: 0.9
                        })
                        .bindPopup(`<b>${s.Nombre}</b><br>${s.Estado ? '✅ Activo' : '❌ Inactivo'}`)
                        .addTo(map);
                        });
                    </script>
                }
            }
        </form>
    </div>
</center>