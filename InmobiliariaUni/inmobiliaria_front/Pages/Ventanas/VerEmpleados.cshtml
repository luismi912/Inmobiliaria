@page
@using presentacion_aspnetcore.Pages
@model EmpleadosModel
@{
    ViewData["Title"] = "Empleadoes";
}
<center>
    <div>
        <form method="POST"  @*Indica como se enviaran los datos*@
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()     @*Esto es un token para darle privacidad a la pagina*@

            <div align="left">
                <h3>Empleados</h3>
            </div>

            @if (Model.empleado != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el empleado de forma permanente?
                            </h6>
                            <h6 align="left">
                                @Model.empleado!.Nombre
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            <div style="margin-right: 30px">
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Refrescar"
                    class="btn btn-secondary"         @*Crear botones para la utilizacion de paginas""*@
                    asp-page-handler="BtRefrescar" />
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Guardar"
                    class="btn btn-secondary"
                    asp-page-handler="BtGuardar"
                    disabled="@(Model.empleado == null)"/>
            </div>

            @if (Model.empleado != null)
            {
                <input type="hidden" 
                    asp-for="@Model.empleado!.Id"/>     @*Sirve para guardar datos sin que el usuario lo vea*@

                <div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.empleado!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Apellido
                        </label>
                        <div class="col-6">
                            <input id="inApellido"
                                   asp-for="@Model.empleado!.Apellido" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Cedula
                        </label>
                        <div class="col-6">
                            <input id="inCedula"
                                   asp-for="@Model.empleado!.Cedula" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha nacimiento
                        </label>
                        <div class="col-6">
                            <input id="inFechaNacimiento"
                                   asp-for="@Model.empleado!.FechaNacimiento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha registro
                        </label>
                        <div class="col-6">
                            <input id="inFechaRegistro"
                                   asp-for="@Model.empleado!.FechaRegistro" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado
                        </label>
                        <div class="col-6">
                            <input id="inEstado"
                                   asp-for="@Model.empleado!.Estado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Nacionalidad
                        </label>
                        <div class="col-6">
                            <input id="inNacionalidad"
                                   asp-for="@Model.empleado!.Nacionalidad" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Horario de trabajo
                        </label>
                        <div class="col-6">
                            <input id="inHorarioTrabajo"
                                   asp-for="@Model.empleado!.HorarioTrabajo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Sueldo
                        </label>
                        <div class="col-6">
                            <input id="inSueldo"
                                   asp-for="@Model.empleado!.Sueldo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Sector
                        </label>
                        <div class="col-6">
                            <input id="inSector"
                                   asp-for="@Model.empleado!.Sector" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            JefeSector
                        </label>
                        <div class="col-6">
                            <input id="inJefeSector"
                                   asp-for="@Model.empleado!.JefeSector" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
            }

            @if (Model != null &&
                 Model.empleados != null &&
                 Model.empleados.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Apellido
                        </th>
                        <th>
                            Cedula
                        </th>
                        <th>
                            Sector
                        </th>
                        <th>
                            Jefe Sector
                        </th>
                        <th>
                            Horario Trabajo
                        </th>
                        <th class="cl_hidden">
                            Sueldo
                        </th>
                        <th class="cl_hidden">
                            Nacionalidad
                        </th>
                    </tr>
                    @foreach (var elemento in Model.empleados)
                    {
                        <tr>
                            <th>
                                @elemento.Nombre
                            </th>
                            <th>
                                @elemento.Apellido
                            </th>
                            <th>
                                @elemento.Cedula
                            </th>
                            <th>
                                @(Model.sectores?.FirstOrDefault(x => x.Id == elemento.Sector)?.Nombre ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.jefes?.FirstOrDefault(x => x.Id == elemento.JefeSector)?.Nombre ?? "Sin tipo")
                            </th>
                            <th>
                                @elemento.HorarioTrabajo
                            </th>
                            <th>
                                @elemento.Sueldo
                            </th>
                            <th>
                                @(Model.nacionalidades?.FirstOrDefault(x => x.Id == elemento.Nacionalidad)?.Nombre ?? "Sin tipo")
                            </th>
                            <th>
                                <input type="submit"
                                    value="Modificar"
                                    asp-page-handler="BtModificar"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                                <input type="submit"
                                    value="Borrar"
                                    asp-page-handler="BtBorrarVal"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                            </th>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>