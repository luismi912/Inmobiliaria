@page
@using presentacion_aspnetcore.Pages
@model DepartamentosModel
@{
    ViewData["Title"] = "Departamentoes";
}
<center>
    <div>
        <form method="POST"  @*Indica como se enviaran los datos*@
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()     @*Esto es un token para darle privacidad a la pagina*@

            <div align="left">
                <h3>Departamentos</h3>
            </div>

            <div style="margin-right: 30px">
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Refrescar"
                    class="btn btn-secondary"         @*Crear botones para la utilizacion de paginas""*@
                    asp-page-handler="BtRefrescar" />
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Nuevo"
                    class="btn btn-secondary"
                    asp-page-handler="BtNuevo"
                    disabled="@(Model.Departamento != null)"/>     @*Hace que el boton quede deshabilitado segun la condicion*@
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Guardar"
                    class="btn btn-secondary"
                    asp-page-handler="BtGuardar"
                    disabled="@(Model.Departamento == null)"/>
            </div>

            @if (Model.Departamento != null)
            {
                <input type="hidden" 
                    asp-for="@Model.Departamento!.Id"/>     @*Sirve para guardar datos sin que el usuario lo vea*@

                <div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Departamento!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado
                        </label>
                        <div class="col-6">
                            <input id="inEstado"
                                   asp-for="@Model.Departamento!.Estado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Latitud
                        </label>
                        <div class="col-6">
                            <input id="inLatitud"
                                   asp-for="@Model.Departamento!.Latitud" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Longitud
                        </label>
                        <div class="col-6">
                            <input id="inLongitud"
                                   asp-for="@Model.Departamento!.Longitud" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
            }

            @if (Model.Departamento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Departamentos?
                            </h6>
                            <h6 align="left">
                                @Model.Departamento!.Nombre
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Lista != null &&
                 Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Estado
                        </th>
                        <th>
                            Latitud
                        </th>
                        <th>
                            Longitud
                        </th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <th>
                                @elemento.Nombre
                            </th>
                            <th>
                                @elemento.Estado
                            </th>
                            <th>
                                @elemento.Latitud
                            </th>
                            <th>
                                @elemento.Longitud
                            </th>
                            <th>
                                <input type="submit"
                                    value="Modificar"
                                    asp-page-handler="BtModificar"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                                <input type="submit"
                                    value="Borrar"
                                    asp-page-handler="BtBorrarVal"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                            </th>
                        </tr>
                    }
                </table>
            }

            @if (Model!.Lista != null && Model.Lista.Count > 0)
            {
                //Cargan la libreria la cual se utiliza para dibujar el mapa
                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />   //El estilo del mapa

                //Funcionalidad del mapa
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

                //Donde se dibujo el mapa con sus valores por alto y ancho
                <div id="map" style="height: 500px; margin-top: 20px; border-radius: 8px; border: 1px solid #ccc;"></div>

                <script>
                    @*La lista la convierte primero a texto json y luego la convierte en un array*@
                    const departamentos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lista));

                    @*Estas son las coordenadas iniciales en las cuales comienza el mapa, su punto de partida*@
                    const map = L.map('map').setView([4.5709, -74.2973], 5);

                    @*Ajusta la perspectiva segun la parte del mapa que estemos mirando*@
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap'
                    }).addTo(map);

                    @*Aqui lo que hace es segun la latitud y la longitud dibujar un circulo verde, dependiendo finalminete del estado si es verde o rojo*@
                    departamentos.forEach(d => {
                    if (d.Latitud == null || d.Longitud == null) return;

                    L.circleMarker([d.Latitud, d.Longitud], {
                    radius: 12,    @*Tamaño medido por el radio*@
                    fillColor: d.Estado ? '#1D9E75' : '#888780',   @*Si esta activo se pone verde si no gris*@
                    color: d.Estado ? '#0F6E56' : '#5F5E5A',
                    weight: 2,  @*Tamaño del borde*@
                    fillOpacity: 0.9    @*Transparencia del relleno*@
                    })
                    .bindPopup(`<b>${d.Nombre}</b><br>${d.Estado ? '✅ Activo' : '❌ Inactivo'}`)  @*Indicador segun el estado poner activo o inactivo*@
                    .addTo(map);  @*El punto se agrega al mapa*@
                    });
                </script>
            }
        </form>
    </div>
</center>