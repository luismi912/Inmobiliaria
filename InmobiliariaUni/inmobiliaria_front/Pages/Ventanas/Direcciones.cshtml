@page
@model DireccionesModel
@{
    ViewData["Title"] = "Direcciones";
}
<center>
    <div>
        <form method="POST"
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()     @*Esto es un token para darle privacidad a la pagina*@

            <div align="left">
                <h3>Direccionees</h3>
            </div>

            <div>
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Refrescar"
                    class="btn btn-secondary"         
                    asp-page-handler="BtRefrescar" />
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Nuevo"
                    class="btn btn-secondary"
                    asp-page-handler="BtNuevo"
                    disabled="@(Model.Direccion != null)"/>     
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Guardar"
                    class="btn btn-secondary"
                    asp-page-handler="BtGuardar"
                    disabled="@(Model.Direccion == null)"/>
            </div>

            @if (Model.Direccion != null)
            {
                <div>
                    <input type="hidden"
                           asp-for="@Model.Direccion!.Id" />

                    <div class="form-group">
                        <label>
                            Tipo de via
                        </label>
                        <div class="col-6">
                            <input id="inTipoVia"
                                    class="cts_forms form-control"
                                    asp-for="@Model.Direccion!.TipoVia" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Numero
                        </label>
                        <div class="col-6">
                            <input id="inNumero"
                                    class="cts_forms form-control"
                                    asp-for="@Model.Direccion!.Numero" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Complemento
                        </label>
                        <div class="col-6">
                            <input id="inComplemento"
                                    asp-for="@Model.Direccion!.Complemento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Ciudades
                        </label>
                        <div class="col-6">
                            @if (Model.Ciudades != null)
                            {
                                <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                        asp-for="@Model.Direccion!.Ciudad" @*Lo guarda en TipoPropiedad*@
                                        asp-items="@(new SelectList(Model.Ciudades, "Id", "Nombre"))">
                                    @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                                    <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                                </select>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Personas
                        </label>
                        <div class="col-6">
                            @if (Model.Personas != null)
                            {
                                <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                        asp-for="@Model.Direccion!.Persona" @*Lo guarda en TipoPropiedad*@
                                        asp-items="@(new SelectList(Model.Personas, "Id", "Nombre"))">
                                    @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                                    <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                                </select>
                            }
                        </div>
                    </div>
                 </div>   
                 
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
            }

            @if (Model.Direccion != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Direccionees?
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.Direcciones != null &&
                 Model.Direcciones.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            TipoVia
                        </th>
                        <th>
                            Numero
                        </th>
                        <th>
                            Complemento
                        </th>
                        <th>
                            Persona
                        </th>
                        <th>
                            Cedula Persona
                        </th>
                        <th class="cl_hidden">
                            Ciudad
                        </th>
                    </tr>
                    @foreach (var elemento in Model.Direcciones)
                    {
                        <tr>
                            <th>
                                @elemento.TipoVia
                            </th>
                            <th>
                                @elemento.Numero!
                            </th>
                            <th>
                                @elemento.Complemento
                            </th>
                            <th class="cl_hidden">
                                @(Model.Personas?.FirstOrDefault(c => c.Id == elemento.Persona)?.Nombre ?? "Sin tipo")
                            </th>
                            <th>
                                Model.CedulaPersona
                            </th>                           
                            <th class="cl_hidden">
                                @(Model.Ciudades?.FirstOrDefault(c => c.Id == elemento.Ciudad)?.Nombre ?? "Sin tipo")
                            </th>                  
                            <th>
                                <input type="submit"
                                    value="Modificar"
                                    asp-page-handler="BtModificar"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                                <input type="submit"
                                    value="Borrar"
                                    asp-page-handler="BtBorrarVal"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                            </th>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>