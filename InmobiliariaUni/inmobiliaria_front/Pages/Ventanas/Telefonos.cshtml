@page
@using inmobiliaria_front.Pages.Ventanas
@using presentacion_aspnetcore.Pages
@model TelefonosModel
@{
    ViewData["Title"] = "Telefonoes";
}
<center>
    <div>
        <form method="POST"
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()     @*Esto es un token para darle privacidad a la pagina*@

            <div align="left">
                <h3>Telefonos</h3>
            </div>

            <div>
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Refrescar"
                    class="btn btn-secondary"         
                    asp-page-handler="BtRefrescar" />
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Nuevo"
                    class="btn btn-secondary"
                    asp-page-handler="BtNuevo"
                    disabled="@(Model.Telefono != null)"/>     
                <input type="submit"
                    style="margin-bottom: 15px"
                    value="Guardar"
                    class="btn btn-secondary"
                    asp-page-handler="BtGuardar"
                    disabled="@(Model.Telefono == null)"/>
            </div>

            @if (Model.Telefono != null)
            {
                <div>
                    <input type="hidden"
                           asp-for="@Model.Telefono!.Id" />

                    <div class="form-group">
                        <label>
                            Numero
                        </label>
                        <div class="col-6">
                            <input id="inNumero"
                                    class="cts_forms form-control"
                                    asp-for="@Model.Telefono!.Numero" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Prefijo
                        </label>
                        <div class="col-6">
                            <input id="inPrefijo"
                                    class="cts_forms form-control"
                                    asp-for="@Model.Telefono!.Prefijo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            personas
                        </label>
                        <div class="col-6">
                            @if (Model.personas != null)
                            {
                                <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                        asp-for="@Model.Telefono.Persona!" @*Lo guarda en TipoPropiedad*@
                                        asp-items="@(new SelectList(Model.personas, "Id", "Nombre"))">
                                    @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                                    <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                                </select>
                            }
                        </div>
                    </div>
                </div>   
                 
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
            }

            @if (Model.Telefono != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Telefonos?
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                 Model.telefonos != null &&
                 Model.telefonos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Numero
                        </th>
                        <th>
                            Prefijo
                        </th>
                        <th>
                            Persona
                        </th>
                        <th class="cl_hidden">
                            Ciudad
                        </th>
                    </tr>
                    @foreach (var elemento in Model.telefonos)
                    {
                        <tr>
                            <th>
                                @elemento.Numero
                            </th>
                            <th>
                                @elemento.Prefijo
                            </th>
                            <th>
                                @(Model.personas?.FirstOrDefault(c => c.Id == elemento.Persona)?.Nombre ?? "Sin tipo")
                            </th>                                                                  
                            <th>
                                <input type="submit"
                                    value="Modificar"
                                    asp-page-handler="BtModificar"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                                <input type="submit"
                                    value="Borrar"
                                    asp-page-handler="BtBorrarVal"
                                    class="btn btn-secondary"
                                    asp-route-data="@elemento.Id" />
                            </th>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>