@page
@using inmobiliaria_front.Pages.Ventanas
@using presentacion_aspnetcore.Pages
@model ContratosArriendosModel
@{
    ViewData["Title"] = "ContratosArriendos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()     @*Esto es un token para darle privacidad a la pagina*@

            <div align="left">
                <h3>Contratos Arriendos</h3>
            </div>

            <div>

                @if (User.IsInRole("Empleado"))
                {
                    <input type="submit"
                           style="margin-bottom: 15px"
                           value="Refrescar"
                           class="btn btn-secondary"
                           asp-page-handler="BtRefrescar" />
                    <input type="submit"
                           style="margin-bottom: 15px"
                           value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo"
                           disabled="@(Model.Contrato != null)" />
                    <input type="submit"
                           style="margin-bottom: 15px"
                           value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar"
                           disabled="@(Model.Contrato == null)" />
                }
            </div>

            @if (Model.Aceptar && Model.Contrato != null)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Estas seguro que deseas aceptar este contrato?
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Aceptar"
                                   asp-page-handler="BtAceptarContrato"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Contrato != null)
            {
                <div>
                    <input type="hidden"
                           asp-for="@Model.Contrato!.Id" />

                    <div class="form-group">
                        <label>
                            Fecha Contrato
                        </label>
                        <div class="col-6">
                            <input id="inFechaContrato"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.FechaContrato" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha Finalizacion
                        </label>
                        <div class="col-6">
                            <input id="inFechaFinalizacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.FechaFinalizacion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado
                        </label>
                        <div class="col-6">
                            <input id="inEstado"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.Estado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Codeudor
                        </label>
                        <div class="col-6">
                            @if (Model.codeudores != null)
                            {
                                <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                        asp-for="@Model.Contrato!.Codeudor" @*Lo guarda en TipoPropiedad*@
                                        asp-items="@(new SelectList(Model.codeudores, "Id", "Cedula"))">
                                    @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                                    <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                                </select>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Comprador
                        </label>
                        <div class="col-6">
                            @if (Model.compradores != null)
                            {
                                <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                        asp-for="@Model.Contrato!.Comprador" @*Lo guarda en TipoPropiedad*@
                                        asp-items="@(new SelectList(Model.compradores, "Id", "Cedula"))">
                                    @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                                    <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                                </select>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Propiedad a comprar
                        </label>
                        <div class="col-6">
                            @if (Model.propiedades != null)
                            {
                                <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                        asp-for="@Model.Contrato!.Propiedad" @*Lo guarda en TipoPropiedad*@
                                        asp-items="@(new SelectList(Model.propiedades, "Id", "Codigo"))">
                                    @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                                    <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                                </select>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Valor Mensual
                        </label>
                        <div class="col-6">
                            <input id="inValorMensual"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.ValorMensual" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Dia pago
                        </label>
                        <div class="col-6">
                            <input id="inDiaPago"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.DiaPago" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Renovable
                        </label>
                        <div class="col-6">
                            <input id="inRenovable"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.Renovable" />
                        </div>
                    </div>
                </div>
                 
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Contrato != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Contrato?
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                             Model.contratos != null &&
                             Model.contratos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Fecha Contrato
                        </th>
                        <th>
                            Fecha Finalizacion
                        </th>
                        <th>
                            Estado
                        </th>
                        <th>
                            Codeudor
                        </th>
                        <th>
                            Cliente
                        </th>
                        <th>
                            Comprador
                        </th>
                        <th class="cl_hidden">
                            Empleado
                        </th>
                        <th class="cl_hidden">
                            Propiedad
                        </th>
                        <th class="cl_hidden">
                           Precio acordado
                        </th>
                        <th class="cl_hidden">
                            Valor mensual
                        </th>
                        <th class="cl_hidden">
                            Dia pago
                        </th>
                        <th class="cl_hidden">
                            Renovable
                        </th>
                    </tr>
                    @foreach (var elemento in Model.contratos!)
                    {
                        
                        <tr>
                            <th>
                                @elemento.FechaContrato
                            </th>
                            <th>
                                @elemento.FechaFinalizacion
                            </th>
                            <th>
                                @elemento.Estado
                            </th>
                            <th>
                                @(Model.codeudores?.FirstOrDefault(x => x.Id == elemento.Codeudor)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.clientes?.FirstOrDefault(x => x.Id == elemento.Cliente)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.compradores?.FirstOrDefault(x => x.Id == elemento.Comprador)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.empleados?.FirstOrDefault(x => x.Id == elemento.EmpleadoSector)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.propiedades?.FirstOrDefault(x => x.Id == elemento.Propiedad)?.Codigo ?? "Sin tipo")
                            </th>
                            <th>
                                @elemento.PrecioAcordado
                            </th>
                            <th>
                                @elemento.ValorMensual
                            </th>
                            <th>
                                @elemento.DiaPago
                            </th>
                            <th>
                                @elemento.Renovable
                            </th>
                            <th>
                                
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                

                                @if (User.IsInRole("Empleado"))
                                {
                                    <input type="submit"
                                           value="Solicitud"
                                           asp-page-handler="BtSolicitud"
                                           class="btn btn-secondary"
                                           asp-route-data="@elemento.Id"
                                           disabled="@(elemento.Estado == "Pendiente")" />
                                }

                                @if (User.IsInRole("Jefe"))
                                {
                                    <input type="submit"
                                           value="VerSolicitud"
                                           asp-page-handler="BtVerSolicitud"
                                           class="btn btn-secondary"
                                           asp-route-data="@elemento.Id" />
                                }
                            </th>
                        </tr>
                    }
                </table>
            }

            <h2>Contratos Aceptados</h2>
            @if (Model != null &&
                             Model.contratosAceptados != null &&
                             Model.contratosAceptados.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Fecha Contrato
                        </th>
                        <th>
                            Fecha Finalizacion
                        </th>
                        <th>
                            Estado
                        </th>
                        <th>
                            Codeudor
                        </th>
                        <th>
                            Cliente
                        </th>
                        <th>
                            Comprador
                        </th>
                        <th class="cl_hidden">
                            Empleado
                        </th>
                        <th class="cl_hidden">
                            Propiedad
                        </th>
                        <th class="cl_hidden">
                            Precio acordado
                        </th>
                        <th class="cl_hidden">
                            Valor mensual
                        </th>
                        <th class="cl_hidden">
                            Dia pago
                        </th>
                        <th class="cl_hidden">
                            Renovable
                        </th>
                    </tr>
                    @foreach (var elemento in Model.contratos!)
                    {
                        
                        <tr>
                            <th>
                                @elemento.FechaContrato
                            </th>
                            <th>
                                @elemento.FechaFinalizacion
                            </th>
                            <th>
                                @elemento.Estado
                            </th>
                            <th>
                                @(Model.codeudores?.FirstOrDefault(x => x.Id == elemento.Codeudor)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.clientes?.FirstOrDefault(x => x.Id == elemento.Cliente)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.compradores?.FirstOrDefault(x => x.Id == elemento.Comprador)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.empleados?.FirstOrDefault(x => x.Id == elemento.EmpleadoSector)?.Cedula ?? "Sin tipo")
                            </th>
                            <th>
                                @(Model.propiedades?.FirstOrDefault(x => x.Id == elemento.Propiedad)?.Codigo ?? "Sin tipo")
                            </th>
                            <th>
                                @elemento.PrecioAcordado
                            </th>
                            <th>
                                @elemento.ValorMensual
                            </th>
                            <th>
                                @elemento.DiaPago
                            </th>
                            <th>
                                @elemento.Renovable
                            </th>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>