@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<form method="POST"  @*Indica como se enviaran los datos*@
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()  
    <div style="border-radius: 10px; border: 6px solid aliceblue; margin: auto; margin-top: 50px; padding: 10px">
        <h1 class="display-4" style="background-color: aliceblue; padding-left: 20px">Login</h1>
        <div>
            <div class="form-group">
                <label>
                    Correo
                </label>
                <div class="col-6">
                    <input id="inCorreo"
                           class="cts_forms form-control"
                           asp-for="@Model.UsuarioRol!.Correo" />
                </div>
            </div>
        </div>
        <div>
            <div class="form-group" style="margin-bottom: 10px">
                <label>
                    Contraseña
                </label>
                <div class="col-6">
                    <input id="inContrasena"
                           type="password"
                           class="cts_forms form-control"
                           asp-for="@Model.UsuarioRol!.Contraseña" />
                </div>
            </div>
        </div>
        <div>
            <div class="form-group" style="margin-bottom: 10px">
                <label>
                    Verificar contraseña
                </label>
                <div class="col-6">
                    <input id="inVerificarContrasena"
                           type="password"
                           class="cts_forms form-control"/>
                </div>
            </div>
        </div>
        <div>
            <label>
                Tipo Empleado
            </label>
            <select class="form-control" asp-for="@Model.UsuarioRol!.Rol">
                <option value="">-- Seleccione un tipo --</option>
                <option value="Empleado">Empleado</option>
                <option value="Jefe">Jefe</option>
                <option value="Administrador">Administrador</option>
            </select>
        </div>
        <div style="margin-top: 10px">
            <input type="submit"
                   value="Ingresar"
                   class="btn btn-secondary"
                   id = "btnIngresar"
                   asp-page-handler="BtIngresar"
                   disabled />
        </div>   
    </div>
</form>

<script>
    const correo = document.getElementById('inCorreo');
    const contrasena = document.getElementById('inContrasena');
    const btn = document.getElementById('btnIngresar');
    const verificarcontrasena = document.getElementById('inVerificarContrasena')

    function validarCampos() {
        btn.disabled = correo.value.trim() === '' || contrasena.value.trim() === '' || verificarcontrasena.value.trim() != contrasena.value.trim();
    }

    correo.addEventListener('input', validarCampos);
    contrasena.addEventListener('input', validarCampos);
    verificarcontrasena.addEventListener('input', validarCampos);
</script>