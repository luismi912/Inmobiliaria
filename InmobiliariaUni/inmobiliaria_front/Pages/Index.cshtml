@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<form method="POST"  @*Indica como se enviaran los datos*@
            enctype="multipart/form-data">
            @Html.AntiForgeryToken()  
    <div>
        <h1 class="display-4" style="background-color: aliceblue; padding-left: 20px">Login</h1>
        <div>
            <div class="form-group">
                <label>
                    Correo
                </label>
                <div class="col-6">
                    <input id="inNombre"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Correo" />
                </div>
            </div>
        </div>
        <div>
            <div class="form-group" style="margin-bottom: 10px">
                <label>
                    Contraseña
                </label>
                <div class="col-6">
                    <input id="inNombre"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Contraseña" />
                </div>
            </div>
        </div>
        <div>
            <label>
                Tipo Empleado
            </label>
            <select class="form-control" asp-for="@Model.UsuarioRol!.Rol">
                <option value="">-- Seleccione un tipo --</option>
                <option value="Empleado">Empleado</option>
                <option value="Jefe">Jefe</option>
                <option value="Administrador">Administrador</option>
            </select>
        </div>

        @*INFORMACION PERSONAL*@
        <div>
            <h1 class ="display-4" style="background-color: aliceblue; padding-left: 10px; margin-top: 50px">Informacion Personal</h1>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Primer Nombre
                </label>
                <div>
                    <input id="inPrimerNombre"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.Nombre" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Primer Apellido
                </label>
                <div>
                    <input id="inPrimerApellido"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.Apellido" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Fecha Nacimiento
                </label>
                <div>
                    <input id="inFechaNacimiento"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.FechaNacimiento" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Fecha Registro
                </label>
                <div>
                    <input id="inFechaRegistro"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.FechaRegistro" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Fecha Registro
                </label>
                <div>
                    <input id="inFechaRegistro"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.FechaRegistro" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Estado
                </label>
                <div>
                    <input id="inEstado"
                           asp-for="@Model.AdminDto!.Administrador.Estado" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Presupuesto Departamental
                </label>
                <div>
                    <input id="inPresupuestoDepartamento"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.PresupuestoDepartamento" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Horario De Trabajo
                </label>
                <div>
                    <input id="inHorarioTrabajo"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.HorarioTrabajo" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Sueldo
                </label>
                <div>
                    <input id="inSueldo"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.Sueldo" />
                </div>
            </div>
            <div class="form-group">
                <label>
                    Departamento
                </label>
                <div class="col-6">
                    @if (Model.Departamentos != null)
                    {
                        <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                asp-for="@Model.AdminDto!.Administrador.Departamento" @*Lo guarda en TipoPropiedad*@
                                asp-items="@(new SelectList(Model.Departamentos, "Id", "Nombre"))">
                            @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                            <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                        </select>
                    }
                </div>
            </div>
            <div class="form-group">
                <label>
                    Nacionalidad
                </label>
                <div class="col-6">
                    @if (Model.Nacionalidades != null)
                    {
                        <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                asp-for="@Model.AdminDto!.Administrador.Nacionalidad" @*Lo guarda en TipoPropiedad*@
                                asp-items="@(new SelectList(Model.Nacionalidades, "Id", "Nombre"))">
                            @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                            <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                        </select>
                    }
                </div>
            </div>
        </div>

        @*DIRECCION*@
        <div>
            <h1 class="display-4" style="background-color: aliceblue; padding-left: 10px; margin-top: 50px">Direccion</h1>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Tipo Via
                </label>
                    <select class="form-control" asp-for="@Model.UsuarioRol!.Rol">
                        <option value="">-- Seleccione un tipo --</option>
                        <option value="Empleado">Empleado</option>
                        <option value="Jefe">Jefe</option>
                        <option value="Administrador">Administrador</option>
                    </select>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Primer Apellido
                </label>
                <div>
                    <input id="inPrimerApellido"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.Apellido" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Fecha Nacimiento
                </label>
                <div>
                    <input id="inFechaNacimiento"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.FechaNacimiento" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Fecha Registro
                </label>
                <div>
                    <input id="inFechaRegistro"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.FechaRegistro" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Fecha Registro
                </label>
                <div>
                    <input id="inFechaRegistro"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.FechaRegistro" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Estado
                </label>
                <div>
                    <input id="inEstado"
                           asp-for="@Model.AdminDto!.Administrador.Estado" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Presupuesto Departamental
                </label>
                <div>
                    <input id="inPresupuestoDepartamento"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.PresupuestoDepartamento" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Horario De Trabajo
                </label>
                <div>
                    <input id="inHorarioTrabajo"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.HorarioTrabajo" />
                </div>
            </div>
            <div>
                <div class="form-group" style="margin-bottom: 10px"></div>
                <label>
                    Sueldo
                </label>
                <div>
                    <input id="inSueldo"
                           class="cts_forms form-control"
                           asp-for="@Model.AdminDto!.Administrador.Sueldo" />
                </div>
            </div>
            <div class="form-group">
                <label>
                    Departamento
                </label>
                <div class="col-6">
                    @if (Model.Departamentos != null)
                    {
                        <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                asp-for="@Model.AdminDto!.Administrador.Departamento" @*Lo guarda en TipoPropiedad*@
                                asp-items="@(new SelectList(Model.Departamentos, "Id", "Nombre"))">
                            @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                            <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                        </select>
                    }
                </div>
            </div>
            <div class="form-group">
                <label>
                    Nacionalidad
                </label>
                <div class="col-6">
                    @if (Model.Nacionalidades != null)
                    {
                        <select class="form-control" @*Crea un dropdown, lista despliegable para abajo*@
                                asp-for="@Model.AdminDto!.Administrador.Nacionalidad" @*Lo guarda en TipoPropiedad*@
                                asp-items="@(new SelectList(Model.Nacionalidades, "Id", "Nombre"))">
                            @*Crea las opciones con parametro( lista de valores, guarda el id, y muestra el nombre)*@
                            <option value="">-- Seleccione un tipo --</option> @*Placeholder o boton para desplegar*@
                        </select>
                    }
                </div>
            </div>
        </div>
        <div style="margin-top: 10px">
            <input type="submit"
                   value="Ingresar"
                   class="btn btn-secondary"
                   asp-page-handler="BtIngresar"/>
        </div>   
    </div>
</form>